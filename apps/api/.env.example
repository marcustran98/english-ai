# LLM: first match wins — OpenAI → Azure → Groq → Grok (see apps/api/app/ai_provider_factory.py)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Azure OpenAI (optional; used if OPENAI_API_KEY is unset)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_DEPLOYMENT_NAME=

# Groq (optional; priority 3 if OpenAI + Azure unset — OpenAI-compatible API)
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile

# xAI Grok (optional; priority 4)
# GROK_API_KEY=
# GROK_BASE_URL=https://api.x.ai/v1
# GROK_MODEL=grok-3-latest

CORS_ORIGINS=http://localhost:3000
